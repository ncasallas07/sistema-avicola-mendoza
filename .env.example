DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=avicola_mendoza
DB_PORT=3306
# Opcional: nombre de la base de datos usada por "npm test".
# Si se omite, se usa "<DB_NAME>_test" por defecto.
# DB_NAME_TEST=avicola_mendoza_test
# Opcional: poner en "true" solo si el proveedor de MySQL exige TLS
# (ver README > Despliegue). No se necesita en desarrollo local.
# DB_SSL=false

PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=8h

# development | test | production. En producción habilita trust proxy
# (necesario detrás del proxy de Render) y endurece el formato de errores.
NODE_ENV=development
# URL pública del frontend desplegado (Vercel), para restringir CORS en
# producción y para construir el enlace de "restablecer contraseña" del
# correo de recuperación. En desarrollo no es necesaria: localhost:5173 ya
# está permitido siempre y se usa como base del enlace por defecto.
# Admite varias URLs separadas por coma (p. ej. producción + preview); se usa
# la primera para armar el enlace de recuperación.
# FRONTEND_URL=https://tu-dominio.vercel.app

# --- Envío de correo (recuperación de contraseña) ---
# Opción 1 (la usada en producción): API HTTPS de Brevo. Los servicios gratuitos
# de Render bloquean los puertos SMTP (25, 465 y 587), así que en Render el
# correo debe enviarse por API (puerto 443), no por SMTP.
# MAIL_FROM_EMAIL debe ser un remitente verificado en Brevo.
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=tu-correo-verificado@ejemplo.com
# MAIL_FROM_NAME=AVÍCOLA MENDOZA
#
# Opción 2: cualquier servidor SMTP (solo si el hosting permite esos puertos).
# Si BREVO_API_KEY está definida, tiene prioridad sobre SMTP.
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
#
# Sin ninguno de los dos: en desarrollo el enlace de recuperación se imprime en
# consola; en producción el envío falla (queda en el log) en vez de fingir que
# se envió.
