DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=avicola_mendoza
DB_PORT=3306
# Opcional: nombre de la base de datos usada por "npm test".
# Si se omite, se usa "<DB_NAME>_test" por defecto.
# DB_NAME_TEST=avicola_mendoza_test
# Opcional: poner en "true" solo si el proveedor de MySQL exige TLS
# (ver README > Despliegue). No se necesita en desarrollo local.
# DB_SSL=false

PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=8h

# development | test | production. En producción habilita trust proxy
# (necesario detrás del proxy de Railway) y endurece el formato de errores.
NODE_ENV=development
# URL pública del frontend desplegado (Vercel), para restringir CORS en
# producción y para construir el enlace de "restablecer contraseña" del
# correo de recuperación. En desarrollo no es necesaria: localhost:5173 ya
# está permitido siempre y se usa como base del enlace por defecto.
# Admite varias URLs separadas por coma (p. ej. producción + preview); se usa
# la primera para armar el enlace de recuperación.
# FRONTEND_URL=https://tu-dominio.vercel.app

# --- Envío de correo (recuperación de contraseña) ---
# Cualquier proveedor SMTP sirve (Gmail, un proveedor transaccional como
# Brevo/SendGrid/Mailtrap en su modo SMTP, etc.) — no se usa un SDK propietario
# a propósito, para no acoplar el proyecto a una sola plataforma. Si SMTP_HOST
# no está configurado, en desarrollo el enlace de recuperación se imprime en
# consola (no se intenta enviar el correo); en producción, si falta, el envío
# falla explícitamente en vez de fingir que se envió.
# SMTP_HOST=smtp.ejemplo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="AVÍCOLA MENDOZA <no-reply@avicolamendoza.com>"
