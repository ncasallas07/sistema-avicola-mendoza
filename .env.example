DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=avicola_mendoza
DB_PORT=3306
# Opcional: nombre de la base de datos usada por "npm test".
# Si se omite, se usa "<DB_NAME>_test" por defecto.
# DB_NAME_TEST=avicola_mendoza_test
# Opcional: poner en "true" solo si el proveedor de MySQL exige TLS
# (ver README > Despliegue). No se necesita en desarrollo local.
# DB_SSL=false

PORT=3000
JWT_SECRET=
JWT_EXPIRES_IN=8h

# development | test | production. En producción habilita trust proxy
# (necesario detrás del proxy de Railway) y endurece el formato de errores.
NODE_ENV=development
# URL pública del frontend desplegado (Vercel), para restringir CORS en
# producción. En desarrollo no es necesaria: localhost:5173 ya está permitido
# siempre. Admite varias URLs separadas por coma (p. ej. producción + preview).
# FRONTEND_URL=https://tu-dominio.vercel.app
